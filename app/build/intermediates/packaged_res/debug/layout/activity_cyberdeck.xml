<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E14">

    <!-- Top Cyberdeck Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#05080C"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Q5-CYBERDECK"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_root_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="[ROOT: UID 0]"
            android:textColor="#FF4444"
            android:textSize="10sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_theme"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="THEME"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#1E2A38"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <Button
            android:id="@+id/btn_restart"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginLeft="6dp"
            android:text="RESET"
            android:textSize="10sp"
            android:textColor="#FF8888"
            android:background="#2E1A1A"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </LinearLayout>

    <!-- Main Terminal View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.bbcyberdeck.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Installation / Loading Overlay -->
        <LinearLayout
            android:id="@+id/layout_installing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#0A0E14"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INITIALIZING CYBERDECK..."
                android:textColor="#00FF66"
                android:textSize="16sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tv_install_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Extracting rootfs..."
                android:textColor="#88FF88"
                android:textSize="12sp"
                android:typeface="monospace" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Soft-Modifier Bar for BlackBerry Physical Keyboard -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#0F141C"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <Button
                android:id="@+id/btn_ctrl"
                android:layout_width="52dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="CTRL"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_alt"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="ALT"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_tab"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="TAB"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_esc"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="ESC"
                android:textColor="#FF6666"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_pipe"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="|"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_tilde"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="~"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_slash"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="/"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_backslash"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="\\"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_dash"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_up"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="▲"
                android:textColor="#00FF66"
                android:textSize="11sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_down"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="▼"
                android:textColor="#00FF66"
                android:textSize="11sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_left"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="◀"
                android:textColor="#00FF66"
                android:textSize="11sp"
                android:background="#1E2836" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:text="▶"
                android:textColor="#00FF66"
                android:textSize="11sp"
                android:background="#1E2836" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
